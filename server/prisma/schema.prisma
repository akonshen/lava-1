generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String
  salt          String
  role          String    @default("user")
  avatar        String?
  phone         String?
  country       String?
  preferredLanguage String @default("en")
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  sessions      Session[]
  guides        Guide[]
  payments      Payment[]
  activities    UserActivity[]
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  lastAccessedAt DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Guide {
  id                String    @id @default(uuid())
  userId            String
  city              String
  medicalType       String
  budgetRange       String
  travelDates       String
  specificNeeds     String?
  medicalHistory    String?
  insurance         String?
  specialRequirements String?
  status            String    @default("pending")
  content           String?
  images            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Payment {
  id                String    @id @default(uuid())
  userId            String
  guideId           String?
  amount            Float
  currency          String    @default("USD")
  status            String    @default("pending")
  stripePaymentId   String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripePaymentId])
  @@index([status])
}

model Hospital {
  id                    String    @id
  name                  String
  nameChinese           String
  address               String
  city                  String
  specialties           String
  internationalDepartment Boolean @default(false)
  englishStaff          Boolean   @default(false)
  jciCertified          Boolean   @default(false)
  rating                Float
  imageUrl              String
  description           String
  phone                 String
  website               String?

  @@index([city])
}

model UserActivity {
  id            String    @id @default(uuid())
  userId        String
  action        String
  details       String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
